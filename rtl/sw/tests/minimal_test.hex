// minimal_test.hex — Simplest possible test program
// Computes 5 + 3 = 8 in x10 (a0), then halts.
// If the processor works, x10 = 8 at halt.
//
// addi x1, x0, 5      →  00500093
// addi x2, x0, 3      →  00300113
// add  x10, x1, x2    →  00208533
// ecall                →  00000073

00500093
00300113
00208533
00000073
